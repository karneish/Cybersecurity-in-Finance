# ─── Database ─────────────────────────────────────────
# All Python services use the libpq "postgresql://" form:
#   Local:   postgresql://postgres:<pass>@localhost:5432/cyberrisk
#   Neon:    postgresql://<user>:<password>@<ep-...>-pooler.<region>.aws.neon.tech/neondb?sslmode=require
#   Render:  injected by render.yaml — never set this by hand there.
#
# This file is read by scripts/dev.ps1 and scripts/dev.sh, which export every
# value below into the environment before launching the ten uvicorn processes.
#
# Local development defaults to the Postgres on your own machine because it is
# faster and works offline. To develop against Neon instead (useful for
# checking the exact behaviour Render will see), swap the line below for:
#
#   DATABASE_URL=postgresql://<user>:<password>@<ep-...>-pooler.<region>.aws.neon.tech/neondb?sslmode=require
#
# Use the POOLED hostname — the one containing `-pooler`. Neon requires TLS;
# deploy/render/start.sh appends sslmode=require automatically if it is absent.
DATABASE_URL=postgresql://postgres:password@localhost:5432/cyberrisk
DB_USER=postgres
DB_PASSWORD=password

# ─── Redis ───────────────────────────────────────────
# Required. The gateway's rate limiter and circuit breaker degrade open without
# it, but ingestion/event fan-out and the /ws STOMP bridge go silent.
# Render injects this automatically from the cyberrisk-redis Key Value instance.
REDIS_URL=redis://localhost:6379

# ─── JWT ─────────────────────────────────────────────
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=replace-with-a-64-char-random-string
# Expiry in SECONDS (Python services)
JWT_EXPIRY=3600
JWT_REFRESH_EXPIRY=604800

# ─── CORS ────────────────────────────────────────────
# Comma-separated OR a JSON array — the gateway accepts both. It must list the
# origin that serves the frontend, with no trailing slash. On Render this must
# be your Vercel origin, e.g. https://cyberrisk.vercel.app
# Leave empty and every browser request is blocked (the gateway logs a warning).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ─── LLM / AI ────────────────────────────────────────
# Leave OPENAI_API_KEY empty and keep USE_MOCK_LLM=true to run fully offline.
OPENAI_API_KEY=
USE_MOCK_LLM=true
LLM_MODEL=gpt-4o

# ─── Service URLs ────────────────────────────────────
# All ten services run as local processes, so everything is on loopback. The
# api-gateway defaults to exactly these values, so you rarely need to set them.
# Ports: gateway 8080 (public), 8081 auth, 8082 asset, 8083 vulnerability,
#        8084 control, 8085 ingestion, 8086 notification, 8090 risk-engine,
#        8091 investment-optimizer, 8092 ai
AUTH_SERVICE_URL=http://localhost:8081
ASSET_SERVICE_URL=http://localhost:8082
VULN_SERVICE_URL=http://localhost:8083
CONTROL_SERVICE_URL=http://localhost:8084
INGESTION_SERVICE_URL=http://localhost:8085
NOTIFICATION_SERVICE_URL=http://localhost:8086
RISK_ENGINE_URL=http://localhost:8090
INVESTMENT_URL=http://localhost:8091
AI_SERVICE_URL=http://localhost:8092

# ─── DB pooling ──────────────────────────────────────
# Total connections ≈ services × (DB_POOL_SIZE + DB_MAX_OVERFLOW). The defaults
# (10 + 20) across eight DB-backed services would open ~240 connections, which
# exceeds most managed Postgres caps, so keep these low.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_PRE_PING=true

# ─── Frontend (Vercel ONLY — do NOT uncomment these here) ─────────
# These are BUILD-TIME variables for the Vercel dashboard. Vite reads VITE_*
# straight out of the process environment, so leaving one uncommented in this
# file overrides the `|| '/api'` fallback in frontend/src/api/client.ts and
# every request 404s at the gateway ("No upstream route for /auth/login").
# scripts/dev.ps1 and scripts/dev.sh skip VITE_* for the same reason.
#
# Locally the Vite dev proxy handles everything: /api -> :8080, /ws -> :8086.
# In Vercel → Settings → Environment Variables, set:
#
#   VITE_API_BASE_URL  = https://<backend>.onrender.com/api   (/api suffix REQUIRED)
#   VITE_WS_URL        = wss://<backend>.onrender.com/ws       (no trailing slash)
#
# VITE_API_BASE_URL=https://cyberrisk-backend.onrender.com/api
# VITE_WS_URL=wss://cyberrisk-backend.onrender.com/ws

# ─── Kafka (Phase 3 — not used in dev) ───────────────
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC_PREFIX=cyberrisk