# ─── Database ─────────────────────────────────────────
# All Python services use the libpq "postgresql://" form:
#   Local:   postgresql://postgres:<pass>@localhost:5432/cyberrisk
#   NeonDB:  postgresql://<user>:<pass>@<host>-pooler.<region>.aws.neon.tech:5432/<db>?sslmode=require
# DB credentials (passed to services via compose)
DATABASE_URL=postgresql://postgres:password@localhost:5432/cyberrisk
DB_USER=postgres
DB_PASSWORD=password

# ─── Redis ───────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── JWT ─────────────────────────────────────────────
JWT_SECRET=replace-with-a-64-char-random-string
# Expiry in SECONDS (Python services)
JWT_EXPIRY=3600
JWT_REFRESH_EXPIRY=604800

# ─── LLM / AI ────────────────────────────────────────
OPENAI_API_KEY=
USE_MOCK_LLM=true
LLM_MODEL=gpt-4o

# ─── Service URLs (for local dev outside Docker) ─────
AUTH_SERVICE_URL=http://localhost:8081
ASSET_SERVICE_URL=http://localhost:8082
VULN_SERVICE_URL=http://localhost:8083
CONTROL_SERVICE_URL=http://localhost:8084
INGESTION_SERVICE_URL=http://localhost:8085
NOTIFICATION_SERVICE_URL=http://localhost:8086
RISK_ENGINE_URL=http://localhost:8090
INVESTMENT_URL=http://localhost:8091
AI_SERVICE_URL=http://localhost:8092

# ─── Frontend ─────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8080
VITE_WS_URL=ws://localhost:8086/ws

# ─── Kafka (Phase 3 — not used in dev) ───────────────
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC_PREFIX=cyberrisk