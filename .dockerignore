# Shared build context (docker-compose builds use ./services as context;
# this prevents stray local files from leaking into build contexts)

# Version control
.git
.gitignore
.gitattributes

# Environment & secrets (never send to build context)
.env
.env.*
!.env.example

# Python
__pycache__
*.pyc
*.pyo
.pytest_cache
.venv
venv

# Node / frontend (built separately; frontend/ has its own .dockerignore)
node_modules

# IDE / editor
.vscode
.idea
*.swp

# Data / backups
database/backups
*.sql.gz