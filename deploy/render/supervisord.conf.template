# CyberRisk Quantifier — supervisord template (generated at boot by start.sh).
#
# start.sh substitutes the __REPO__ / __RUNTIME__ / __PYTHON__ / __NGINX__
# placeholders with paths resolved on the live host, then launches supervisord
# against the generated copy. Do not edit the generated file — edit this one.
#
# ── Why there are only TWO programs now ──────────────────────────────────────
# This used to start ten uvicorn processes, one per service. That costs roughly
# 1.0-1.4 GB because each process loads its own copy of the interpreter and of
# numpy/pandas/scipy/scikit-learn/xgboost/ortools.
#
# Render's Free plan gives a web service 512 MB, so all ten services now run in
# ONE process (deploy/render/serve_all.py), sharing a single event loop. Each
# service keeps its own port and its own ASGI app, so every route and every
# inter-service HTTP URL is unchanged — only the process topology differs.
#
# Measured footprint of the consolidated process: ~231 MB.
#
# nginx is still the public edge and owns $PORT: /api/* and /health go to the
# gateway on 18080, /ws goes to notification-service on 8086. The services
# themselves bind 127.0.0.1, so nothing but nginx is reachable from outside.

[supervisord]
nodaemon = true
logfile = /dev/stdout
logfile_maxbytes = 0
pidfile = __RUNTIME__/supervisord.pid
childlogdir = __RUNTIME__

[program:backend]
command = __PYTHON__ __REPO__/deploy/render/serve_all.py
directory = __REPO__
priority = 100
autostart = true
autorestart = true
startsecs = 20
startretries = 5
stopwaitsecs = 20
# serve_all.py turns SIGTERM into a graceful shutdown of all ten servers.
stopsignal = TERM
stopasgroup = true
killasgroup = true
stdout_logfile = /dev/stdout
stdout_logfile_maxbytes = 0
redirect_stderr = true
environment = PYTHONUNBUFFERED="1"

[program:nginx]
command = __NGINX__ -c __RUNTIME__/nginx.conf -g "daemon off;"
priority = 200
autostart = true
autorestart = true
startsecs = 5
startretries = 20
stopwaitsecs = 10
stdout_logfile = /dev/stdout
stdout_logfile_maxbytes = 0
redirect_stderr = true